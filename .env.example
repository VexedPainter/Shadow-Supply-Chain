# Shadow Supply Chain — Environment Variables Template
# Copy this file to .env and fill in your API keys

# ── Admin Credentials (REQUIRED in production) ─────────────────────
# Change both of these before deploying. The fallback values are for
# local development only and must never be used in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying

# ── CORS allowed origins (comma-separated, no trailing slash) ───────
# Example for production: ALLOWED_ORIGINS=https://your-domain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Groq API Key (get from https://console.groq.com) ────────────────
GROQ_API_KEY=gsk_your_groq_key_here

# ── Cohere API Key (get from https://dashboard.cohere.com) ──────────
COHERE_API_KEY=your_cohere_key_here

# ── B5: Database URL ─────────────────────────────────────────────────
# For development (default — zero config):
# DATABASE_URL=sqlite:///./shadow_supply.db
# For production (PostgreSQL — one env var switches the entire data layer):
# DATABASE_URL=postgresql://user:password@host:5432/shadowsync_db
# Note: postgres:// URLs from Heroku/Render are auto-converted to postgresql://

# ── B3: Critical Alert Configuration (all optional) ─────────────────
# Email alerts for HIGH/CRITICAL shadow purchases.
# Leave blank to disable email alerts silently.
ALERT_EMAIL_USER=your_gmail@gmail.com
ALERT_EMAIL_PASS=your_app_password
ALERT_EMAIL_TO=procurement-manager@yourcompany.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587

# Slack webhook for real-time notifications.
# Create at: https://api.slack.com/messaging/webhooks
# Leave blank to disable Slack alerts silently.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
